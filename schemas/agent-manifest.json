{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.acp-protocol.org/schemas/agent-manifest/1.0/schema.json",
  "title": "ACP Agent Manifest",
  "description": "Signed document mapping an AID to its endpoint and public key. RFC-ACP-0002.",
  "type": "object",
  "required": ["acp_version", "agent_id", "endpoint", "public_key", "manifest_sig"],
  "properties": {
    "acp_version": { "type": "string", "const": "1.0" },
    "agent_id": { "type": "string", "pattern": "^acp://[^/]+/.+$" },
    "display_name": { "type": "string", "maxLength": 100 },
    "endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "public_key": {
      "type": "object",
      "required": ["kty", "crv", "x"],
      "properties": {
        "kty": { "type": "string", "const": "OKP" },
        "crv": { "type": "string", "const": "Ed25519" },
        "x": { "type": "string", "description": "Base64url Ed25519 public key" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^acp://cap\\." }
    },
    "protocols": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["ACP/1.0"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "maintenance", "revoked"],
      "default": "active"
    },
    "manifest_created": { "type": "string", "format": "date-time" },
    "manifest_sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "additionalProperties": false
}
